---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout title="New Entry | Ink Between">
  <main class="min-h-screen bg-[#fdfcfb] py-12 px-4 font-sans text-stone-800">
    <section
      class="max-w-2xl mx-auto bg-white border border-stone-100 shadow-sm rounded-3xl p-8 md:p-12"
    >
      <header class="mb-10 text-center">
        <h1 class="text-4xl font-serif tracking-tight text-stone-900">
          New Reading Note
        </h1>
        <p class="text-stone-400 font-light mt-2 italic text-lg">
          Archiving thoughts into the digital shelves.
        </p>
      </header>

      <div class="mb-12 bg-stone-50/50 p-6 rounded-2xl border border-stone-100">
        <label class="form-label !text-stone-400">Search Open Library</label>
        <div class="flex gap-2">
          <input
            id="api-search"
            type="text"
            class="form-input flex-1 bg-white"
            placeholder="Search title or author..."
          />
          <button
            id="search-btn"
            type="button"
            class="bg-stone-200 text-stone-600 px-6 rounded-xl hover:bg-stone-300 transition-colors font-medium text-sm"
            >Find</button
          >
        </div>

        <div id="results-container" class="mt-4 space-y-2 hidden">
          <p class="text-[10px] uppercase tracking-widest text-stone-400 mb-2">
            Select a match:
          </p>
          <div id="results-list" class="grid grid-cols-1 gap-2"></div>
        </div>

        <p
          id="search-status"
          class="text-[10px] mt-2 text-stone-400 italic hidden"
        >
        </p>
        <p
          id="no-api-note"
          class="text-[10px] mt-2 text-amber-600 italic hidden"
        >
          ⚠️ Note: No book selected. Entry will be saved without external link
          or cover.
        </p>
      </div>

      <form id="book-form" class="space-y-12">
        <div class="space-y-6">
          <span class="section-divider">The Core</span>
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label class="form-label">Title *</label>
              <input
                id="field-title"
                name="title"
                type="text"
                required
                class="form-input font-serif text-lg"
              />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="form-label">Author *</label>
                <input
                  id="field-author"
                  name="author"
                  type="text"
                  required
                  class="form-input"
                />
              </div>
              <div>
                <label class="form-label">Genre *</label>
                <input
                  id="field-genre"
                  name="genre"
                  type="text"
                  required
                  class="form-input"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <span class="section-divider">The Ledger</span>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end">
            <div class="space-y-4">
              <div>
                <label class="form-label">Total Pages *</label>
                <input
                  id="field-pages"
                  name="pages"
                  type="number"
                  required
                  class="form-input"
                />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="form-label">Started *</label>
                  <input
                    name="start_date"
                    type="date"
                    required
                    class="form-input !py-2 text-sm"
                  />
                </div>
                <div>
                  <label class="form-label">Finished *</label>
                  <input
                    name="end_date"
                    type="date"
                    required
                    class="form-input !py-2 text-sm"
                  />
                </div>
              </div>
            </div>

            <div
              class="bg-stone-50/50 p-6 rounded-2xl border border-stone-100 flex flex-col items-center justify-center"
            >
              <label class="form-label mb-3">Overall Rating *</label>
              <div class="star-rating">
                <input
                  type="radio"
                  id="star5"
                  name="rating"
                  value="5"
                  class="hidden"
                  checked
                /><label for="star5">★</label>
                <input
                  type="radio"
                  id="star4"
                  name="rating"
                  value="4"
                  class="hidden"
                /><label for="star4">★</label>
                <input
                  type="radio"
                  id="star3"
                  name="rating"
                  value="3"
                  class="hidden"
                /><label for="star3">★</label>
                <input
                  type="radio"
                  id="star2"
                  name="rating"
                  value="2"
                  class="hidden"
                /><label for="star2">★</label>
                <input
                  type="radio"
                  id="star1"
                  name="rating"
                  value="1"
                  class="hidden"
                /><label for="star1">★</label>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <span class="section-divider">Reflection</span>
          <div>
            <label class="form-label">Review *</label>
            <textarea
              name="review"
              rows="5"
              required
              class="form-input resize-none"
              placeholder="Required..."></textarea>
          </div>
          <div>
            <label class="form-label">Quote (Optional)</label>
            <textarea
              name="quote"
              rows="2"
              class="form-input font-serif italic border-l-4 border-stone-100 pl-4"
            ></textarea>
          </div>
        </div>

        <div
          class="bg-stone-50/30 p-8 rounded-3xl border border-stone-100 space-y-6"
        >
          <span class="section-divider !border-stone-200"
            >Character Spotlight (Optional)</span
          >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <input
              name="favourite_character_name"
              type="text"
              class="form-input bg-white"
              placeholder="Name"
            />
            <input
              name="favourite_character_quote"
              type="text"
              class="form-input bg-white italic"
              placeholder="Quote"
            />
          </div>
          <textarea
            name="favourite_character_review"
            rows="2"
            class="form-input bg-white"
            placeholder="Review"></textarea>
        </div>

        <input type="hidden" id="field-cover" name="cover_url" />
        <input type="hidden" id="field-external" name="external_url" />

        <div id="status-container" class="hidden">
          <p
            id="status-text"
            class="text-sm italic text-center p-4 rounded-2xl"
          >
          </p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-stone-900 text-stone-50 py-5 rounded-2xl font-medium hover:bg-black transition-all"
        >
          Archive Entry
        </button>
      </form>
    </section>
  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  const {
    data: { session },
  } = await supabase.auth.getSession();

  if (!session) {
    // Si no hay sesión, rebota al login
    window.location.href = "/login";
  }

  const searchBtn = document.getElementById("search-btn");
  const searchInput = document.getElementById("api-search") as HTMLInputElement;
  const resultsContainer = document.getElementById("results-container");
  const resultsList = document.getElementById("results-list");
  const searchStatus = document.getElementById("search-status");
  const noApiNote = document.getElementById("no-api-note");

  const fTitle = document.getElementById("field-title") as HTMLInputElement;
  const fAuthor = document.getElementById("field-author") as HTMLInputElement;
  const fPages = document.getElementById("field-pages") as HTMLInputElement;
  const fGenre = document.getElementById("field-genre") as HTMLInputElement;
  const fCover = document.getElementById("field-cover") as HTMLInputElement;
  const fExternal = document.getElementById(
    "field-external",
  ) as HTMLInputElement;

  searchBtn?.addEventListener("click", async () => {
    const query = searchInput.value;
    if (!query || !searchStatus || !resultsList || !resultsContainer) return;

    searchStatus.innerText = "Searching Open Library...";
    searchStatus.classList.remove("hidden");
    resultsContainer.classList.add("hidden");
    noApiNote?.classList.remove("hidden"); // Mostrar nota por defecto

    try {
      const response = await fetch(
        `https://openlibrary.org/search.json?q=${encodeURIComponent(query)}&limit=5`,
      );
      const data = await response.json();

      resultsList.innerHTML = "";

      if (data.docs && data.docs.length > 0) {
        resultsContainer.classList.remove("hidden");
        searchStatus.innerText = `Found ${data.docs.length} matches:`;

        data.docs.forEach((book: any) => {
          const coverId = book.cover_i;
          const coverUrl = coverId
            ? `https://covers.openlibrary.org/b/id/${coverId}-S.jpg`
            : null;
          const year = book.first_publish_year || "N/A";
          const author = book.author_name ? book.author_name[0] : "Unknown";

          const card = document.createElement("div");
          card.className =
            "flex items-center gap-4 p-3 bg-white border border-stone-200 rounded-xl cursor-pointer hover:border-stone-400 hover:bg-stone-50 transition-all";
          card.innerHTML = `
            <div class="w-12 h-16 bg-stone-100 rounded overflow-hidden flex-shrink-0">
              ${coverUrl ? `<img src="${coverUrl}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center text-[8px] text-stone-300">No Cover</div>`}
            </div>
            <div class="flex-1 overflow-hidden">
              <h4 class="text-sm font-bold truncate text-stone-800">${book.title}</h4>
              <p class="text-[10px] text-stone-500">${author} • ${year}</p>
            </div>
          `;

          card.onclick = () => {
            fTitle.value = book.title || "";
            fAuthor.value = author;
            fPages.value =
              book.number_of_pages_median || book.number_of_pages?.[0] || "";
            fGenre.value = book.subject ? book.subject[0] : "";
            fCover.value = coverId
              ? `https://covers.openlibrary.org/b/id/${coverId}-L.jpg`
              : "";
            fExternal.value = `https://openlibrary.org${book.key}`;

            noApiNote?.classList.add("hidden"); // Ocultar nota si se seleccionó uno
            resultsContainer.classList.add("hidden");
            searchStatus.innerText = `✅ Selected: ${book.title}`;
          };

          resultsList.appendChild(card);
        });
      } else {
        searchStatus.innerText = "❌ No books found.";
      }
    } catch (e) {
      searchStatus.innerText = "❌ Connection error.";
    }
  });

  const form = document.getElementById("book-form") as HTMLFormElement;
  const statusContainer = document.getElementById("status-container");
  const statusText = document.getElementById("status-text");
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!btn || !statusText || !statusContainer) return;

    btn.innerText = "Saving...";
    btn.disabled = true;

    const formData = new FormData(form);
    const rawData = Object.fromEntries(formData);

    const record = {
      ...rawData,
      pages: rawData.pages ? parseInt(rawData.pages.toString()) : null,
      rating: rawData.rating ? parseInt(rawData.rating.toString()) : null,
    };

    try {
      const { error } = await supabase.from("book_reviews").insert([record]);
      if (error) throw error;
      statusText.innerText = "✅ Entry archived!";
      statusText.className =
        "bg-green-50 text-green-700 p-4 rounded-2xl text-center italic border border-green-100";
      statusContainer.classList.remove("hidden");
      setTimeout(() => (window.location.href = "/"), 1200);
    } catch (err: any) {
      statusText.innerText = "❌ Error: " + err.message;
      statusText.className =
        "bg-red-50 text-red-700 p-4 rounded-2xl text-center italic border border-red-100";
      statusContainer.classList.remove("hidden");
      btn.disabled = false;
      btn.innerText = "Retry";
    }
  });
</script>

---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import "../styles/global.css";

// Traemos los datos de Supabase
const { data: posts, error } = await supabase
  .from("book_reviews")
  .select("*")
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error fetching books:", error);
}
---

<Layout title="Library | Ink Between">
  <main class="min-h-screen bg-[#fdfcfb] py-20 px-6">
    <header class="max-w-5xl mx-auto mb-16 border-b border-stone-100 pb-12">
      <h1 class="text-5xl font-serif text-stone-800 tracking-tight">
        The Library
      </h1>
      <p class="text-stone-400 font-light mt-4 text-xl italic">
        "Digital ink, timeless thoughts."
      </p>
      <div class="mt-8">
        <a
          href="/admin/create"
          class="inline-block bg-stone-800 text-stone-50 px-8 py-3 rounded-2xl text-sm font-medium hover:bg-black hover:-translate-y-0.5 transition-all shadow-lg shadow-stone-200"
        >
          + New Entry
        </a>
      </div>
    </header>

    <section class="max-w-5xl mx-auto">
      {
        posts && posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16">
            {posts.map((book) => (
              <a href={`/book/${book.id}`} class="group">
                <article class="group">
                  <div class="aspect-[3/4] bg-stone-100 rounded-2xl overflow-hidden mb-8 shadow-sm group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-500 border border-stone-200/50 relative">
                    {/* Imagen de Portada */}
                    {book.cover_url ? (
                      <img
                        src={book.cover_url}
                        alt={book.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="absolute inset-0 flex items-center justify-center p-8 text-center bg-stone-50">
                        <span class="text-stone-300 font-serif italic text-xl">
                          {book.title}
                        </span>
                      </div>
                    )}

                    {/* Overlay con la Quote al hacer Hover */}
                    <div class="absolute inset-0 bg-stone-900/80 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-8">
                      <p class="text-stone-50 font-serif italic text-center text-sm leading-relaxed">
                        {book.quote
                          ? `${book.quote}`
                          : "No quote archived yet."}
                      </p>
                    </div>
                  </div>

                  <div class="space-y-3">
                    <div class="flex justify-between items-start">
                      <h2 class="text-2xl font-serif text-stone-800 leading-tight">
                        {book.title}
                      </h2>
                      <div class="flex items-center gap-0.5 pt-1">
                        {[...Array(5)].map((_, i) => (
                          <span
                            class={
                              i < (book.rating || 0)
                                ? "text-amber-500 text-xs"
                                : "text-stone-200 text-xs"
                            }
                          >
                            ★
                          </span>
                        ))}
                      </div>
                    </div>

                    <p class="text-stone-400 font-medium uppercase tracking-[0.2em] text-[10px]">
                      {book.author}
                    </p>

                    {/* Tag del Género */}
                    {book.genre && (
                      <span class="inline-block text-[10px] text-stone-400 border border-stone-200 px-2 py-0.5 rounded-full uppercase tracking-widest">
                        {book.genre}
                      </span>
                    )}
                  </div>
                </article>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-20">
            <p class="text-stone-400 italic font-light text-lg">
              The shelves are currently empty...
            </p>
          </div>
        )
      }
    </section>
  </main>
</Layout>

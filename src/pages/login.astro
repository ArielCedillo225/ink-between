---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

// Si ya hay una sesión activa, mandamos al admin directamente
// Nota: Esto es SSR, revisamos las cookies/sesión aquí
---

<Layout title="Login | Ink Between">
  <main class="min-h-screen bg-[#fdfcfb] flex items-center justify-center px-4">
    <div
      class="max-w-md w-full bg-white border border-stone-100 shadow-sm rounded-3xl p-10"
    >
      <header class="text-center mb-10">
        <h1 class="text-3xl font-serif text-stone-900">
          Hold on you cheeky human!
        </h1>
        <p class="text-stone-400 italic mt-2">
          You need to be logged to write reviews.
        </p>
      </header>

      <form id="login-form" class="space-y-6">
        <div>
          <label class="form-label">Email</label>
          <input
            type="email"
            name="email"
            required
            class="form-input"
            placeholder="tu@email.com"
          />
        </div>
        <div>
          <label class="form-label">Password</label>
          <input
            type="password"
            name="password"
            required
            class="form-input"
            placeholder="••••••••"
          />
        </div>

        <div
          id="error-msg"
          class="hidden text-xs text-red-500 italic bg-red-50 p-3 rounded-xl border border-red-100 text-center"
        >
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full bg-stone-900 text-stone-50 py-4 rounded-2xl font-medium hover:bg-black transition-all shadow-lg shadow-stone-200"
        >
          Enter Archive
        </button>

        <div class="text-center pt-4">
          <a
            href="/"
            class="text-stone-400 hover:text-stone-800 transition-colors text-sm font-light italic"
          >
            ← Back to Library
          </a>
        </div>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-msg");
  const btn = document.getElementById("login-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!errorMsg || !btn) return;

    btn.innerText = "Verifying...";
    btn.disabled = true;
    errorMsg.classList.add("hidden");

    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorMsg.innerText = "❌ " + error.message;
      errorMsg.classList.remove("hidden");
      btn.innerText = "Enter Archive";
      btn.disabled = false;
    } else {
      window.location.href = "/admin/create";
    }
  });
</script>

---
// src/pages/book/[id].astro
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import "../../styles/global.css";

export const prerender = false;

// 1. Obtenemos el ID de la URL
const { id } = Astro.params;

// 2. Traemos el libro específico de Supabase
const { data: book, error } = await supabase
  .from("book_reviews")
  .select("*")
  .eq("id", id)
  .single();

// 3. Si hay error o no existe, redirigimos a la Home
if (error || !book) {
  return Astro.redirect("/");
}

// Formateador de fechas para que se vean bonitas
const formatDate = (dateStr: string) => {
  if (!dateStr) return "N/A";
  return new Date(dateStr).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
};
---

<Layout title={`${book.title} | Ink Between`}>
  <main class="min-h-screen bg-[#fdfcfb] py-20 px-6 font-sans text-stone-800">
    <div class="max-w-4xl mx-auto">
      <a
        href="/"
        class="text-stone-400 hover:text-stone-800 transition-colors text-sm mb-12 inline-block"
      >
        ← Back to Library
      </a>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-16">
        <aside class="md:col-span-4 space-y-8">
          <div
            class="aspect-[3/4] bg-stone-100 rounded-2xl overflow-hidden shadow-2xl border border-stone-200/50"
          >
            {
              book.cover_url ? (
                <img
                  src={book.cover_url}
                  alt={book.title}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="h-full flex items-center justify-center text-stone-300 italic p-6 text-center">
                  No cover archived
                </div>
              )
            }
          </div>

          <div class="space-y-6 pt-4">
            <div>
              <span class="section-divider">The Ledger</span>
              <div class="space-y-3 text-sm">
                <p class="flex justify-between">
                  <span class="text-stone-400">Pages:</span>
                  <span>{book.pages || "???"}</span>
                </p>
                <p class="flex justify-between">
                  <span class="text-stone-400">Genre:</span>
                  <span>{book.genre || "N/A"}</span>
                </p>
                <p class="flex justify-between">
                  <span class="text-stone-400">Started:</span>
                  <span>{formatDate(book.start_date)}</span>
                </p>
                <p class="flex justify-between">
                  <span class="text-stone-400">Finished:</span>
                  <span>{formatDate(book.end_date)}</span>
                </p>
              </div>
            </div>

            {
              book.external_url && (
                <a
                  href={book.external_url}
                  target="_blank"
                  class="block text-center py-3 px-4 rounded-xl border border-stone-200 text-stone-500 text-xs uppercase tracking-widest hover:bg-stone-50 transition-all"
                >
                  View on Open Library ↗
                </a>
              )
            }
          </div>
        </aside>

        <article class="md:col-span-8 space-y-12">
          <header class="space-y-4">
            <div class="flex justify-between items-start">
              <h1 class="text-6xl font-serif text-stone-900 leading-tight">
                {book.title}
              </h1>

              <a
                href={`/admin/edit/${book.id}`}
                class="auth-only bg-stone-100 text-stone-600 px-4 py-2 rounded-xl text-xs hover:bg-stone-200 transition-all"
              >
                Edit Entry
              </a>
            </div>
            <div class="flex items-center gap-4">
              <p class="text-xl text-stone-400 font-light italic">
                by {book.author}
              </p>
              <div class="flex text-amber-500">
                {
                  [...Array(5)].map((_, i) => (
                    <span
                      class={
                        i < (book.rating || 0) ? "opacity-100" : "opacity-20"
                      }
                    >
                      ★
                    </span>
                  ))
                }
              </div>
            </div>
          </header>

          <div class="space-y-8">
            <section>
              <span class="section-divider">Reflection</span>
              <p
                class="text-lg leading-relaxed text-stone-700 whitespace-pre-line font-light"
              >
                {book.review || "No review written for this entry."}
              </p>
            </section>

            {
              book.quote && (
                <blockquote class="bg-stone-50 p-10 rounded-3xl border-l-4 border-stone-200 italic font-serif text-2xl text-stone-800 leading-relaxed">
                  {book.quote}
                </blockquote>
              )
            }

            {
              (book.favourite_character_name ||
                book.favourite_character_review) && (
                <section class="bg-stone-900 text-stone-100 p-10 rounded-[2.5rem] shadow-xl space-y-6">
                  <span class="text-[10px] uppercase tracking-[0.3em] text-stone-500 font-bold block">
                    Character Spotlight
                  </span>
                  <div class="space-y-2">
                    <h3 class="text-3xl font-serif">
                      {book.favourite_character_name}
                    </h3>
                    {book.favourite_character_quote && (
                      <p class="text-stone-400 italic font-serif">
                        "{book.favourite_character_quote}"
                      </p>
                    )}
                  </div>
                  <p class="text-stone-300 font-light leading-relaxed border-t border-stone-800 pt-6">
                    {book.favourite_character_review}
                  </p>
                </section>
              )
            }
          </div>
        </article>
      </div>
    </div>
  </main>
</Layout>
